@article{wang2002,
	title = {A point interpolation meshless method based on radial basis functions},
	volume = {54},
	rights = {http://onlinelibrary.wiley.com/{termsAndConditions}\#vor},
	issn = {0029-5981, 1097-0207},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/nme.489},
	doi = {10.1002/nme.489},
	abstract = {Abstract A point interpolation meshless method is proposed based on combining radial and polynomial basis functions. Involvement of radial basis functions overcomes possible singularity associated with the meshless methods based on only the polynomial basis. This non‐singularity is useful in constructing well‐performed shape functions. Furthermore, the interpolation function obtained passes through all scattered points in an influence domain and thus shape functions are of delta function property. This makes the implementation of essential boundary conditions much easier than the meshless methods based on the moving least‐squares approximation. In addition, the partial derivatives of shape functions are easily obtained, thus improving computational efficiency. Examples on curve/surface fittings and solid mechanics problems show that the accuracy and convergence rate of the present method is high. Copyright © 2002 John Wiley \& Sons, Ltd.},
	pages = {1623--1648},
	number = {11},
	journaltitle = {International Journal for Numerical Methods in Engineering},
	shortjournal = {Int. J. Numer. Methods Eng.},
	author = {Wang, J. G. and Liu, G. R.},
	urldate = {2026-11-05},
	date = {2002-08-20},
	langid = {english},
	note = {tex.citation-number: 16.},
}

