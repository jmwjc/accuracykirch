	date = {2006-10-08},
	langid = {english},
	note = {tex.citation-number: 34.},
}

@article{duan2012,
	title = {Second-order accurate derivatives and integration schemes for meshfree methods},
	volume = {92},
	rights = {http://onlinelibrary.wiley.com/{termsAndConditions}\#vor},
	issn = {0029-5981, 1097-0207},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/nme.4359},
	doi = {10.1002/nme.4359},
	abstract = {{SUMMARY} The consistency condition for the nodal derivatives in traditional meshfree Galerkin methods is only the differentiation of the approximation consistency ({DAC}). One missing part is the consistency between a nodal shape function and its derivatives in terms of the divergence theorem in numerical forms. In this paper, a consistency framework for the meshfree nodal derivatives including the {DAC} and the discrete divergence consistency ({DDC}) is proposed. The summation of the linear {DDC} over the whole computational domain leads to the so‐called integration constraint in the literature. A three‐point integration scheme using background triangle elements is developed, in which the corrected derivatives are computed by the satisfaction of the quadratic {DDC}. We prove that such smoothed derivatives also meet the quadratic {DAC}, and therefore, the proposed scheme possesses the quadratic consistency that leads to its name {QC}3. Numerical results show that {QC}3 is the only method that can pass both the linear and the quadratic patch tests and achieves the best performances for all the four examples in terms of stability, convergence, accuracy, and efficiency among all the tested methods. Particularly, it shows a huge improvement for the existing linearly consistent one‐point integration method in some examples. Copyright © 2012 John Wiley \& Sons, Ltd.},
	pages = {399--424},
	number = {4},
	journaltitle = {International Journal for Numerical Methods in Engineering},
	shortjournal = {Int. J. Numer. Methods Eng.},
	author = {Duan, Qinglin and Li, Xikui and Zhang, Hongwu and Belytschko, Ted},
	urldate = {2026-11-05},
	date = {2012-10-26},
	langid = {english},
	note = {tex.citation-number: 35.},
}

